# Local environment for the Drive → MDX sync. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# `.env` is gitignored and is symlinked into every argus task worktree
# (see worktree.config), so one copy at the repo root serves all of them.
#
# Read by scripts/sync-test.sh, which sources this file as shell — so shell
# syntax ($HOME, quoting) works. Anything already exported in your shell
# takes precedence, so one-off overrides still work:
#
#   GDRIVE_CONTENT_ROOT_ID=<other-folder> ./scripts/sync-test.sh --dry-run

# Drive folder ID of the content root — the folder holding `universities/`
# and `scholarships/`. A full folder URL also works; the pipeline strips it
# down to the ID (scripts/drive_sync/fetch.py:37).
GDRIVE_CONTENT_ROOT_ID=

# Path to the service-account JSON key. The key itself is deliberately NOT
# inlined here: it's a private credential, and this file gets symlinked into
# every worktree. sync-test.sh reads the path and exports the JSON contents
# as GDRIVE_SERVICE_ACCOUNT_JSON for the pipeline.
#
# The service account needs Drive `drive.readonly` scope and Viewer access on
# the content-root folder above.
GDRIVE_SERVICE_ACCOUNT_JSON_FILE=$HOME/.gcloud-keys/collegesaurus-drive-sync.json

# Optional. Only needed to point the floating chat bubble at a local Streamlit
# instance; docusaurus.config.ts:111 already defaults to the live app. Note
# that Docusaurus does NOT read this file — export it inline when you need it:
#   CHAT_URL=http://localhost:8501 npm run start
# CHAT_URL=http://localhost:8501

# Copy to .env and fill in. Gitignored; symlinked into each worktree.
# Read by scripts/sync-test.sh (sourced as shell). Exported vars win.

# Drive folder holding universities/ and scholarships/. A URL works too.
GDRIVE_CONTENT_ROOT_ID=

# Path to the service-account key, not the key itself.
GDRIVE_SERVICE_ACCOUNT_JSON_FILE=$HOME/.gcloud-keys/collegesaurus-drive-sync.json

# Optional, and Docusaurus does not read this file:
#   CHAT_URL=http://localhost:8501 npm run start
